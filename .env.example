# ---- API -------------------------------------------------------------------
ENVIRONMENT=development
STORAGE_DIR=./storage
MAX_UPLOAD_MB=60
MIN_DURATION_S=5
MAX_DURATION_S=600
RETENTION_HOURS=24
# Background retention sweep interval. 0 disables it (the boot sweep still runs).
RETENTION_SWEEP_MINUTES=30

# Backends. Start on the stubs; switch once requirements-ml.txt is installed.
# separation:    stub | demucs
# transcription: stub | basic_pitch
# drums:         stub | onset
# timing:        stub | librosa   (tempo, metre, key from the full mix)
# mastering:     loudness | matchering
SEPARATION_BACKEND=stub
TRANSCRIPTION_BACKEND=stub
DRUM_BACKEND=stub
TIMING_BACKEND=stub
MASTERING_BACKEND=loudness

DEMUCS_MODEL=htdemucs_6s
DEMUCS_DEVICE=cpu
# 0 = choose a safe default for the platform. On Windows that is 1: Demucs runs its
# workers as separate processes and torch + Windows multiprocessing crashes with an
# access violation partway through a full track. Safe to raise on Linux/macOS/Docker.
DEMUCS_JOBS=0
# Lower is faster; below ~0.1 the seams between chunks can become audible.
DEMUCS_OVERLAP=0.25

JOB_BACKEND=inline
MAX_CONCURRENT_JOBS=2
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000"]

# ---- Legal -----------------------------------------------------------------
REQUIRE_RIGHTS_ATTESTATION=true
DMCA_CONTACT_EMAIL=dmca@example.com

# ---- Web -------------------------------------------------------------------
API_ORIGIN=http://localhost:8000

# ---- Windows only ----------------------------------------------------------
# The ML stack cannot live in the project tree on Windows (MAX_PATH). Point the
# dev scripts at the short-path venv built by scripts/install-ml.ps1.
# See docs/RUNBOOK.md.
# EXTRACT0R_VENV=C:\Users\you\.x0r-venv

# ── reference library ────────────────────────────────────────────────────────
# A folder of music you already own. extract0r measures the files in it and ranks
# them as reference candidates for whatever you are mastering - tonal balance,
# loudness and stereo image, rather than a genre tag.
#
# It exists because the obvious version of this feature cannot be built. Streaming
# links are refused by name: the audio is what makes a reference useful, and a
# streaming service will not hand it over on terms this tool is willing to accept.
# Nothing is copied out of the folder and no audio leaves the machine - only the
# measurements are kept.
#
# LIBRARY_DIR=D:\Music
# LIBRARY_MAX_TRACKS=2000

# Where saved reference profiles live. A profile is what a song teaches - its tonal
# balance, loudness and stereo image - kept as numbers so it can be aimed at again
# without the audio. Outside the storage root on purpose: the retention sweep clears
# tracks from there, and profiles are meant to outlive every track that used them.
#
# PROFILE_DIR=./profiles
